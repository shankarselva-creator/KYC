#include <windows.h>

// Elevation manifest for the installer.
1 RT_MANIFEST "setup.manifest"

// The application executable, embedded so Setup is fully self-contained.
MAINEXE RCDATA "build/DataRecovery.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Hard Disk Data Recovery Setup"
      VALUE "FileVersion",     "0.1.0.0"
      VALUE "ProductName",     "Hard Disk Data Recovery"
      VALUE "ProductVersion",  "0.1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
